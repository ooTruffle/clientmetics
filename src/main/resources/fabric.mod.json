{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "ooTruffle"
  ],
  "environment": "client",
  "entrypoints": {
    "init": [
      "${base_group}.Clientmetics"
    ]
  },
  "mixins": [
    "mixins.${mod_id}.json"
  ],
  "depends": {
    "java": ">=${java_version}",
    "minecraft": "${minecraft_version}",
    "fabricloader": ">=${fabric_loader_version}",
    "osl-entrypoints": "*",
    "polycompose": ">=3.0.0"
  },
  "suggests": {
    "clienttag": "*",
    "essential": "*",
    "oneconfig": ">=1.9.0"
  }
}
